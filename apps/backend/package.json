{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Trainer App — Fastify + Drizzle backend API",
  "scripts": {
    "dev":          "tsx watch --env-file=.env src/index.ts",
    "build":        "tsc --outDir dist",
    "start":        "node dist/index.js",
    "typecheck":    "tsc --noEmit",
    "lint":         "NODE_NO_WARNINGS=1 eslint . --max-warnings 0",
    "test":         "vitest run",
    "test:watch":   "vitest",
    "test:db:prepare": "drizzle-kit push --config drizzle.ci.config.ts",
    "test:db":      "vitest run --config vitest.db.config.ts",
    "test:coverage":"vitest run --coverage",
    "db:generate":  "drizzle-kit generate",
    "db:migrate":   "drizzle-kit migrate",
    "db:push":      "drizzle-kit push",
    "db:seed":      "tsx --env-file=.env src/db/seeds/index.ts",
    "db:studio":    "drizzle-kit studio"
  },
  "dependencies": {
    "@trainer-app/shared":     "workspace:*",
    "@sentry/node":            "^10.75.0",
    "@fastify/cookie":         "^11.1.2",
    "@fastify/cors":           "^11.3.0",
    "@fastify/helmet":         "^13.1.1",
    "@fastify/multipart":      "^10.1.1",
    "@fastify/rate-limit":     "^11.2.0",
    "@fastify/swagger":        "^9.8.1",
    "@fastify/swagger-ui":     "^6.1.1",
    "fastify":                 "^5.12.5",
    "fastify-type-provider-zod":"^4.0.2",
    "argon2":                  "^0.31.2",
    "jsonwebtoken":            "^9.0.2",
    "drizzle-orm":             "^0.30.10",
    "pg":                      "^8.11.5",
    "zod":                     "^3.25.76",
    "dotenv":                  "^16.4.5",
    "cloudinary":              "^2.2.0",
    "resend":                  "^3.2.0",
    "bullmq":                  "^5.81.5",
    "pino-pretty":             "^11.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken":      "^9.0.6",
    "@types/node":              "^20.12.12",
    "@types/pg":                "^8.11.6",
    "@vitest/coverage-v8":     "^1.6.0",
    "drizzle-kit":             "^0.21.4",
    "tsx":                     "^4.11.0",
    "typescript":              "^5.4.5",
    "vitest":                  "^1.6.0",
    "eslint":                  "^9.0.0",
    "typescript-eslint":       "^8.0.0",
    "@trainer-app/eslint-config": "workspace:*"
  }
}
